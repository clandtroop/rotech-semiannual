{
  "name": "rotech-semiannual",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node -e \"require('fs').copyFileSync('dist/index.html','dist/404.html')\"",
    "build:hosted": "VITE_BASE=/ npm run build",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist",
    "test:rules": "firebase emulators:exec --only firestore --project rotech-rules-test \"node test/firestore-rules.test.mjs\""
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "firebase": "^12.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.16",
    "gh-pages": "^6.1.1",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.6",
    "vite": "^7.3.6"
  }
}
